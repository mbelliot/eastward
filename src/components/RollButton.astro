
---
import { cva, type VariantProps } from "class-variance-authority"
import RollText from "./RollText.astro"

const variants = cva(
	"cursor-pointer relative leading-none bg-cta inline-flex items-center justify-center uppercase rounded-[24px] w-max",
	{
		variants: {
			variant: {
				primary: "bg-tint text-inverted",
				dimmed: "bg-text text-inverted",
				outline: "border-1 text-text",
				plain: "",
			},
			size: {
				md: "py-[15px] px-[30px]",
				sm: "py-[10px] px-[15px]",
			},
		},
		defaultVariants: {
			variant: "primary",
			size: "md",
		},
	},
)

type Props = VariantProps<typeof variants>

let { variant, size } = Astro.props
---

<roll-button>
  <button class={variants({variant, size})}>
    <RollText inactive><slot /></RollText>
  </button>
</roll-button>

<script>
  class RollButton extends HTMLElement {
    connectedCallback() {
      let button = this.children[0],
        text = this.querySelector("roll-text")
      if(!text)return
    
      button.addEventListener("pointerenter", () => {
        text.play()
      })
      button.addEventListener("pointerleave", () => {
        text.reverse()
      })
    }
  }
  customElements.define("roll-button", RollButton)
</script>
