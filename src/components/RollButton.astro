---
import { cva, type VariantProps } from 'class-variance-authority'
import RollText from './RollText.astro'
import type { HTMLAttributes } from 'astro/types'

const variants = cva(
  'cursor-pointer relative leading-none bg-cta inline-flex items-center justify-center uppercase rounded-[24px] w-max',
  {
    variants: {
      variant: {
        primary: 'bg-tint text-inverted',
        mono: 'bg-text text-inverted',
        outline: 'border-1 text-text',
        plain: '',
      },
      size: {
        md: 'py-[15px] px-[30px]',
        sm: 'py-[10px] px-[15px]',
      },
    },
    defaultVariants: {
      variant: 'primary',
      size: 'md',
    },
  },
)

type Props = VariantProps<typeof variants> & HTMLAttributes<'button'>

let { variant, size, class: cls, ...attrs } = Astro.props
---

<button class:list={[variants({ variant, size }), cls]} data-roll-trigger {...attrs}>
  <RollText><slot /></RollText>
</button>
