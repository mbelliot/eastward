---
import { type HTMLAttributes } from "astro/types"
import { cva, type VariantProps } from "class-variance-authority"
import RollText from "./RollText.astro"

let variants = cva("cursor-pointer uppercase", {
	variants: {
		variant: {
			title: "text-inverted",
			text: "text-text",
		},
	},
	defaultVariants: { variant: "text" },
})

type Props = VariantProps<typeof variants> & HTMLAttributes<"a">

let { variant = "text", class: cls, ...rest } = Astro.props
---

<a data-roll-trigger class:list={[ variants({variant}), cls ]} {...rest}>
	<RollText underline={variant==='text'}>
		<slot />
	</RollText>
</a>
