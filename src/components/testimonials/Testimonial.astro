---
import Icon from '@/Icon.astro'
import Picture from '@/Picture.astro'
import type { HTMLAttributes } from 'astro/types'
import type { Testimonial } from 'sanity.types'

interface Props extends HTMLAttributes<'figure'> {
  testimonial: Testimonial
}
const { testimonial, class: cls, ...attrs } = Astro.props
---

<figure class:list={['grid lg:grid-cols-[480px_369px] grid-rows-min gap-5', cls]} {...attrs}>
  <blockquote
    class="text-quote max-w-[40ch] lg:col-[1/3] lg:row-[1/2] z-10 pr-20 will-change-transform"
  >
    <Icon name="Quotes" class="w-25 -ml-5" />
    {testimonial.quote}
  </blockquote>
  <figcaption class="flex flex-col *:text-end lg:col-[1/2] self-end will-change-transform">
    <span>{testimonial.name}</span>
    <span>{testimonial.title}</span>
  </figcaption>
  {
    testimonial.headshot && (
      <Picture
        pictureClass="max-lg:hidden col-[2/3] row-[1/3] pt-40 [--alpha-top:rgba(0,0,0,0)] will-change-transform"
        class="object-cover w-[370px]"
        src={testimonial.headshot}
        alt={testimonial.headshot.alt ?? ''}
        sources={[{ media: '(min-width:0px)', widths: [370], aspect: 5 / 7 }]}
        style="mask-image:linear-gradient(to top, black 0, var(--alpha-top) 100%);"
      />
    )
  }
</figure>
