---
import Icon from '@/Icon.astro'
import Picture from '@/Picture.astro'
import type { HTMLAttributes } from 'astro/types'
import type { Testimonial } from 'sanity.types'

interface Props extends HTMLAttributes<'figure'> {
  testimonial: Testimonial
}
const { testimonial, class: cls, ...attrs } = Astro.props
---

<figure class:list={['grid grid-cols-[480px_369px] grid-rows-min gap-5', cls]} {...attrs}>
  <blockquote class="text-quote max-w-[40ch] col-[1/3] row-[1/2] z-10 pr-20">
    <Icon name="Quotes" class="w-25 -ml-5" />
    {testimonial.quote}
  </blockquote>
  <figcaption class="flex flex-col *:text-end col-[1/2] self-end">
    <span>{testimonial.name}</span>
    <span>{testimonial.title}</span>
  </figcaption>
  {
    testimonial.headshot && (
      <Picture
        pictureClass="col-[2/3] row-[1/3] pt-40"
        class="object-cover w-[370px] mask-t-from-0"
        src={testimonial.headshot}
        alt={testimonial.headshot.alt ?? ''}
        sources={[{ media: '(min-width:0px)', widths: [370], aspect: 5 / 7 }]}
      />
    )
  }
</figure>
