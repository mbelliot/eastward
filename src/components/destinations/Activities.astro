---
import type { HTMLAttributes } from 'astro/types'
import type { Destination } from 'sanity.types'
import Activity from './Activity.astro'

interface Props extends HTMLAttributes<'div'> {
  activities: NonNullable<Destination['activities']>
}

const { activities } = Astro.props
---

{
  activities.map((att, i) => (
    <Activity
      class:list={[i % 2 ? 'xl:col-[8/13]' : 'xl:col-[2/7]', 'max-xl:col-[2/18] max-h-[70dvh]']}
      activity={att}
    />
  ))
}
