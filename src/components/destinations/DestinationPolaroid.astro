---
/**
 * DestinationPolaroid
 * Scatter-layout image collage using Mitchell's Best-Candidate algorithm.
 *
 */
import { sanityClient } from 'sanity:client'
import { createImageUrlBuilder } from '@sanity/image-url'
import { defineQuery } from 'groq'

interface Props {
  slug: string
  density?: number
  imageSize?: number
}

const { slug, density = 0.6, imageSize = 300 } = Astro.props

const query = defineQuery(`
  *[_type == "destination" && slug.current == $slug][0] {
    "images": (
      attractions[].image {
        ...,
        "dimensions": asset->metadata.dimensions
      }
      + activities[].image {
        ...,
        "dimensions": asset->metadata.dimensions
      }
      + foods[].image {
        ...,
        "dimensions": asset->metadata.dimensions
      }
    )
  }
`)

const result = await sanityClient.fetch(query, { slug })
const images = result?.images ?? []
const builder = createImageUrlBuilder(sanityClient)
---

<destination-polaroid
  class="block relative size-full overflow-visible perspective-normal"
  data-density={density}
  data-image-size={imageSize}
  aria-hidden="true"
>
  {
    images.map((img) => (
      <img
        class="absolute invisible left-0 top-0 object-cover will-change-transform"
        src={builder.image(img).width(imageSize).url()}
        loading="lazy"
        decoding="async"
      />
    ))
  }
</destination-polaroid>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr]
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[a[i], a[j]] = [a[j], a[i]]
    }
    return a
  }

  function getScatterLayout(
    imgs: HTMLImageElement[],
    containerWidth: number,
    containerHeight: number,
    imageSize: number,
  ) {
    const placed: any[] = []
    const candidatesPerImage = 15
    const targetArea = imageSize * imageSize

    return imgs.map((img) => {
      const aspect = img.naturalWidth / img.naturalHeight || 1
      const h = Math.sqrt(targetArea / aspect)
      const w = h * aspect

      let bestCandidate = null
      let maxMinDist = -1

      for (let i = 0; i < candidatesPerImage; i++) {
        const x = Math.random() * (containerWidth - w)
        const y = Math.random() * (containerHeight - h)
        const candidate = { x, y, w, h, cx: x + w / 2, cy: y + h / 2 }

        if (placed.length === 0) {
          bestCandidate = candidate
          break
        }

        let minDistToOthers = Infinity
        let tooMuchOverlap = false

        for (const p of placed) {
          const d = Math.hypot(candidate.cx - p.cx, candidate.cy - p.cy)

          const horizontalOverlap =
            Math.min(candidate.x + candidate.w, p.x + p.w) - Math.max(candidate.x, p.x)
          const verticalOverlap =
            Math.min(candidate.y + candidate.h, p.y + p.h) - Math.max(candidate.y, p.y)

          if (horizontalOverlap > 0 && verticalOverlap > 0) {
            const overlapArea = horizontalOverlap * verticalOverlap
            const selfArea = candidate.w * candidate.h
            if (overlapArea / selfArea > 0.2) {
              tooMuchOverlap = true
              break
            }
          }

          if (d < minDistToOthers) minDistToOthers = d
        }

        if (tooMuchOverlap) continue
        if (minDistToOthers > maxMinDist) {
          maxMinDist = minDistToOthers
          bestCandidate = candidate
        }
      }

      const result = bestCandidate ?? { x: 0, y: 0, w, h, cx: w / 2, cy: h / 2 }
      placed.push(result)
      return result
    })
  }

  class DestinationPolaroid extends HTMLElement {
    resizeObserver!: ResizeObserver
    resizeTimer!: ReturnType<typeof setTimeout>
    tl!: gsap.core.Timeline
    layoutGen = 0

    connectedCallback() {
      this.layout()

      this.resizeObserver = new ResizeObserver(() => {
        if (this.resizeTimer) clearTimeout(this.resizeTimer)
        this.resizeTimer = setTimeout(() => this.layout(), 150)
      })
      this.resizeObserver.observe(this)
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect()
      if (this.resizeTimer) clearTimeout(this.resizeTimer)
    }

    layout() {
      const myGen = ++this.layoutGen
      const density = parseFloat(this.dataset.density ?? '0.6')
      const imageSize = parseFloat(this.dataset.imageSize ?? '300')
      const { offsetWidth: width, offsetHeight: height } = this

      if (width === 0 || height === 0) {
        requestAnimationFrame(() => this.layout())
        return
      }

      if (this.tl) {
        this.tl.kill()
        gsap.set(this.querySelectorAll('img'), { clearProps: 'all' })
      }

      const allImgs = shuffle(Array.from(this.querySelectorAll('img')))

      const idealCount = Math.floor((width * height * density) / (imageSize * imageSize))
      const finalLimit = Math.min(idealCount, allImgs.length)
      const subset = allImgs.slice(0, finalLimit)

      const waitForLoad = subset.map(
        (img) =>
          new Promise((resolve) => {
            if (img.complete) resolve(null)
            else img.addEventListener('load', resolve, { once: true })
          }),
      )

      Promise.all(waitForLoad).then(() => {
        if (myGen !== this.layoutGen) return

        allImgs.forEach((img) => {
          if (!subset.includes(img)) img.style.display = 'none'
        })

        const layoutData = getScatterLayout(subset, width, height, imageSize)

        this.tl = gsap.timeline({
          defaults: { ease: 'sine.out' },
          scrollTrigger: {
            trigger: this,
            start: 'top 50%',
            toggleActions: 'play pause resume pause',
          },
        })

        subset.forEach((img, i) => {
          const pos = layoutData[i]
          if (!pos) return

          const rotate = Math.random() * 20 - Math.random() * 20
          // 1. Find the center of the container and center of the target image
          const containerCx = width / 2
          const containerCy = height / 2
          const targetCx = pos.x + pos.w / 2
          const targetCy = pos.y + pos.h / 2

          // 2. Calculate the directional vector from center to target
          const dx = targetCx - containerCx
          const dy = targetCy - containerCy
          const distance = Math.hypot(dx, dy) || 1 // Avoid division by zero

          // 3. Normalize the vector
          const nx = dx / distance
          const ny = dy / distance

          // 4. Calculate a safe offscreen distance based on container bounds
          // Pushing it by the diagonal size of the container guarantees it starts completely offscreen
          const offscreenTravel = Math.hypot(width, height) / 2

          // 5. Invert the vector (-nx, -ny) to move to the opposite side
          const startX = containerCx - nx * offscreenTravel - pos.w / 2
          const startY = containerCy - ny * offscreenTravel - pos.h / 2

          // 6. Uniform speed calculation (e.g., 800 pixels per second)
          const finalTravelDistance = Math.hypot(pos.x - startX, pos.y - startY)
          const speed = 500
          const duration = finalTravelDistance / speed

          // 7. Make rotation speed proportional to duration so angular velocity is constant
          const degreesPerSecond = 120
          const startRotate = rotate - duration * degreesPerSecond
          this.tl.set(img, { width: pos.w, height: pos.h, zIndex: i, autoAlpha: 1 })
          this.tl.fromTo(
            img,
            { x: startX, y: startY, rotate: startRotate },
            { x: pos.x, y: pos.y, rotate, duration: i < (subset.length * 3) / 5 ? 0 : duration },
          )
        })
      })
    }
  }

  customElements.define('destination-polaroid', DestinationPolaroid)
</script>
