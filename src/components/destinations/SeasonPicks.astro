---
import Picture from '@/Picture.astro'
import SectionTitle from '@/SectionTitle.astro'
import type { Destination } from 'sanity.types'
import DestinationLabel from './DestinationLabel.astro'
import TextBlock from '@/TextBlock.astro'
import RollLink from '@/RollLink.astro'

interface Props {
  destinations: NonNullable<
    Pick<Destination, 'cover' | 'name' | 'country' | 'slug'> & {
      commentary: string | null
      portrait: Destination['portrait'] | null
    }
  >[]
}

export const seasonPicksFragment = `{
  cover,
  portrait,
  name,
  country,
  commentary,
  slug
  }`

const { destinations } = Astro.props
---

{
  destinations?.length && (
    <section class="main-grid main-container main-spacing gap-y-0">
      <SectionTitle
        class="col-span-full max-xl:*:text-center xl:col-[2/5] clamp-[mb,20px,100px]"
        title="Season's Picks"
        desc="Handpicked journeys timed for the season's best weather, culture, and pace."
      />
      {destinations.map((dest, index) => {
        const odd = index % 2 === 0
        return (
          <article class="mb-(--clamp-main-bottom-space) col-span-full grid grid-cols-subgrid gap-y-12.5">
            <div class="relative col-[2/12] aspect-anamorphic">
              <Picture
                pictureClass="block absolute inset-0"
                class="size-full object-cover"
                src={dest.cover}
                alt={dest.cover.alt ?? ''}
                sources={[
                  { media: '(min-width:0px)', widths: [400, 800, 1200, 1600], aspect: 2.39 / 1 },
                ]}
              />
              <DestinationLabel
                class:list={['absolute bottom-8', odd ? 'left-8' : 'right-8']}
                name={dest.name}
                country={dest.country}
              />
            </div>
            <div
              class:list={['max-lg:col-[2/12]', odd ? 'col-[2/7]' : 'col-[7/12] justify-self-end']}
            >
              <TextBlock
                class="max-w-125 clamp-[mt,0px,50px,400px,2560px]"
                text={dest.commentary ?? ''}
              />
            </div>
            <div
              class:list={[
                'relative overflow-visible col-[2/12] max-lg:hidden',
                odd ? 'lg:col-[8/13]' : 'lg:col-[1/6] lg:row-end-3',
              ]}
            >
              {dest.portrait && (
                <Picture
                  pictureClass={`absolute bottom-0 overflow-visible bg-inverted clamp-[p,10px,18px,640px,2400px] ${odd ? 'right-0' : 'left-0'}`}
                  class="clamp-[w,210px,560px,320px,2560px]"
                  src={dest.portrait}
                  sources={[{ media: '(min-width:0px)', widths: [420, 640] }]}
                  alt={dest.portrait?.alt ?? ''}
                />
              )}
            </div>
            <div
              class:list={['max-lg:col-[2/12]', odd ? 'col-[2/6]' : 'col-[7/12] flex justify-end']}
            >
              <div class="flex flex-col items-start gap-[25px] w-full max-w-125">
                <RollLink href={`/destinations/${dest.slug.current}`}>Explore Details</RollLink>
                <RollLink href={`/destinations/${dest.slug.current}#itineraries`}>
                  View Itineraries
                </RollLink>
              </div>
            </div>
          </article>
        )
      })}
    </section>
  )
}
