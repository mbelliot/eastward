---
import Picture from '@/Picture.astro'
import SectionTitle from '@/SectionTitle.astro'
import type { Destination } from 'sanity.types'
import DestinationLabel from './DestinationLabel.astro'
import TextBlock from '@/TextBlock.astro'
import RollLink from '@/RollLink.astro'

type Props = { destinations: Destination[] }
const { destinations } = Astro.props
---

{
  destinations?.length && (
    <section class="lg:main-grid main-container main-spacing">
      <SectionTitle
        class="col-[2/5]"
        title="Season's Picks"
        desc="Handpicked journeys timed for the season's best weather, culture, and pace."
      />
      {destinations
        .filter((dest) => dest.featured)
        .map((dest, index) => {
          const odd = index % 2 === 0
          return (
            <article class="mt-25 col-span-full grid grid-cols-subgrid gap-y-12.5">
              <div class="relative col-[2/12] aspect-anamorphic">
                <Picture
                  pictureClass="block absolute inset-0"
                  class="size-full object-cover"
                  src={dest.cover}
                  alt={dest.cover.alt ?? ''}
                  sources={[
                    { media: '(min-width:0px)', widths: [400, 800, 1200, 1600], aspect: 2.39 / 1 },
                  ]}
                />
                <DestinationLabel
                  class:list={['absolute bottom-8', odd ? 'left-8' : 'right-8']}
                  name={dest.name}
                  country={dest.country}
                />
              </div>
              <div class={odd ? 'col-[2/7]' : 'col-[7/12] justify-self-end'}>
                <TextBlock class="max-w-125" text={dest.commentary ?? ''} />
              </div>
              <div
                class={`relative overflow-visible ${odd ? 'col-[8/13]' : 'col-[1/6] row-end-3'}`}
              >
                <Picture
                  pictureClass={`absolute bottom-0 overflow-visible bg-inverted clamp-[p,10px,18px,640px,2400px] ${odd ? 'right-0' : 'left-0'}`}
                  class="clamp-[w,420px,640px,640px,2560px]"
                  src={dest.portrait!}
                  sources={[{ media: '(min-width:0px)', widths: [420, 640] }]}
                  alt={dest.portrait?.alt ?? ''}
                />
              </div>
              <div class={odd ? 'col-[2/6]' : 'col-[7/12] flex justify-end'}>
                <div class="flex flex-col items-start gap-[25px] w-full max-w-125">
                  <RollLink href={`/destinations/${dest.slug.current}`}>Explore Details</RollLink>
                  <RollLink href={`/destinations/${dest.slug.current}#itineraries`}>
                    View Itineraries
                  </RollLink>
                </div>
              </div>
            </article>
          )
        })}
    </section>
  )
}
