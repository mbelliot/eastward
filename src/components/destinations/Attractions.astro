---
import type { HTMLAttributes } from 'astro/types'
import type { Destination } from 'sanity.types'
import Picture, { fullscreenSources } from '@/Picture.astro'
import RichText from '@/RichText.astro'
import Template from '@/Template.astro'

interface Props extends HTMLAttributes<'div'> {
  attractions: Array<
    NonNullable<Destination['attractions']>[number] & {
      location?: string
      country?: string
    }
  >
}

const { attractions, class: cls, ...attrs } = Astro.props
---

<attractions-reel
  class:list={[
    'relative flex clamp-[gap-x,20px,25px] items-end overflow-visible',
    'max-[1200px]:clamp-[mt,7,10] min-[1200px]:clamp-[mt,-85px,-155px,1200px,2560px]',
    cls,
  ]}
  {...attrs}
>
  {
    attractions.map((attraction) => (
      <button data-slide data-cursor-area="magnifier" data-cursor-blend>
        <figure class="flex flex-col gap-2.5 h-full min-h-0">
          <div class="flex-1 relative overflow-clip">
            <Picture
              draggable="false"
              alt={attraction.image.alt ?? ''}
              class="absolute inset-0 size-full object-cover select-none"
              src={attraction.image}
              sources={[
                {
                  media: '(min-width: 1200px)',
                  sizes: '56vw',
                  widths: [800, 1280, 1600],
                  aspect: 7 / 5,
                },
                {
                  media: '(min-width: 640px) and (max-width: 1199px)',
                  sizes: '56vw',
                  widths: [640, 1024],
                  aspect: 4 / 5,
                },
                {
                  media: '(max-width: 639px)',
                  sizes: '92vw',
                  widths: [480, 800],
                  aspect: 4 / 5,
                },
              ]}
            />
          </div>
          <figcaption class="invisible">
            <p class="text-left">{attraction.title}</p>
            {attraction.location && (
              <p class="ml-px text-left text-label uppercase">
                {`${attraction.location}${attraction.country ? `, ${attraction.country}` : ''}`}
              </p>
            )}
          </figcaption>
        </figure>
        <Template class="modalPayload">
          <Picture
            class="absolute inset-0 w-full h-full object-cover"
            src={attraction.image}
            alt={attraction.image.alt ?? ''}
            sources={fullscreenSources}
          />
          <RichText text={attraction.body} />
        </Template>
      </button>
    ))
  }
</attractions-reel>

<script>
  import { focusReel } from '~/lib/focusReel'
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  class AttractionsReel extends HTMLElement {
    #abortController!: AbortController

    connectedCallback() {
      this.#abortController = new AbortController()

      const move = focusReel(this, this.#abortController.signal),
        root = this.closest('[data-focus-reel-root]')

      if (root) {
        root.querySelector('[data-previous-slide]')?.addEventListener(
          'click',
          () => {
            move(1)
          },
          { signal: this.#abortController.signal },
        )

        root.querySelector('[data-next-slide]')?.addEventListener(
          'click',
          () => {
            move(-1)
          },
          { signal: this.#abortController.signal },
        )
      }

      this.querySelectorAll('[data-slide]').forEach((slide) => {
        slide.addEventListener('click', () => {
          const template = slide.querySelector('.modalPayload') as HTMLTemplateElement
          const modal = document.querySelector('slide-modal')
          if (template && modal) {
            modal.show(template.content)
          }
        })
      })

      gsap.from(this.querySelectorAll('[data-slide] img'), {
        scale: 1.3,
        scrollTrigger: {
          trigger: this.querySelector('[data-slide] figure > :first-child'),
          scrub: true,
          start: 'top bottom',
          end: 'bottom bottom',
        },
      })

      ScrollTrigger.batch(this.querySelectorAll('[data-slide] figcaption'), {
        once: true,
        onEnter: (batch) =>
          gsap.from(batch, {
            delay: 0.2,
            autoAlpha: 0,
            yPercent: 100,
            duration: 0.6,
            stagger: 0.2,
          }),
      })
    }

    disconnectedCallback() {
      this.#abortController.abort()
    }
  }

  customElements.define('attractions-reel', AttractionsReel)
</script>
