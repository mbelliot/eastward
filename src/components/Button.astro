---
import { Icon } from 'astro-icon/components'
import IconButton from '@/IconButton.astro'
import { cva, type VariantProps } from 'class-variance-authority'
import type { HTMLAttributes } from 'astro/types'

const variants = cva('disabled:opacity-50 disabled:pointer-events-none', {
  variants: {
    variant: {
      mono: 'text-mono',
      inverted: 'text-inverted',
    },
  },
  defaultVariants: { variant: 'mono' },
})

const iconNames = {
    'arrow-right': 'ph:arrow-right-light',
    'arrow-left': 'ph:arrow-left-light',
    grid: 'ph:squares-four-light',
    list: 'ph:list-light',
    filter: 'ph:funnel-simple-light',
    x: 'ph:x-light',
  } as const,
  directions = { 'arrow-right': 'right', 'arrow-left': 'left' }

type Name = keyof typeof iconNames

type Props = VariantProps<typeof variants> &
  HTMLAttributes<'button'> & { name: Name; outline?: boolean; rootAttrs?: HTMLAttributes<'div'> }

const { class: cls, variant, name, outline = true, rootAttrs, ...attrs } = Astro.props
---

<IconButton
  class:list={['size-[45px] relative', variants({ variant }), cls]}
  {...attrs}
  direction={(directions as any)[name]}
  variant={outline ? 'outline' : 'ghost'}
  rootAttrs={rootAttrs}
>
  <Icon
    class:list={['size-[28px] group-aria-pressed:text-text', variants({ variant })]}
    name={iconNames[name]}
  />
</IconButton>
