---
import Picture, { fullscreenSources } from '@/Picture.astro'
import type { Itinerary } from 'sanity.types'

interface Props {
  itinerary: NonNullable<Pick<Itinerary, 'cover' | 'title' | 'tagline'>> & {
    destinations: number
    days: number
  }
  heroClass?: string
}

export const itineraryBannerFragment = `
{
  cover,
  title,
  tagline,
  "destinations": coalesce(count(destinations), 0),
  "days": coalesce(count(schedule), 0)
}
`

const { itinerary, heroClass } = Astro.props
---

<figure class="w-full relative clamp-[py,200px,350px,370px,2560px]">
  <Picture
    pictureClass="block absolute inset-0"
    class="size-full object-cover brightness-50"
    src={itinerary.cover}
    sources={fullscreenSources}
    alt={itinerary.cover.alt ?? ''}
  />
  <figcaption
    class:list={[
      'relative w-[62%] mx-auto max-w-250 flex flex-col gap-[30px] items-center justify-center *:text-inverted *:text-center',
      heroClass,
    ]}
  >
    <h3 class="text-masthead">{itinerary.title}</h3>
    <div class="flex flex-col items-center gap-[5px]">
      <p class="text-byline">{itinerary.tagline}</p>
      <p class="text-h4">{itinerary.days} days, {itinerary.destinations} destinations</p>
    </div>
  </figcaption>
</figure>
