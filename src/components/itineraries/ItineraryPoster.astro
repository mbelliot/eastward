---
import { cva, type VariantProps } from 'class-variance-authority'
import type { HTMLAttributes } from 'astro/types'
import type { Itinerary } from 'sanity.types'
import Picture, { fullscreenSources } from '@/Picture.astro'
import RollLink from '@/RollLink.astro'

interface ElProps extends HTMLAttributes<'article'> {
  itinerary: NonNullable<
    Pick<Itinerary, 'slug' | 'cover' | 'portrait' | 'title' | 'tagline' | 'overview'>
  > & {
    destinations: number
    days: number
  }
}

type Props = ElProps & VariantProps<typeof variants>

export const itineraryPosterFragment = `
{
  slug,
  cover,
  ...select(defined(portrait) => { portrait }),
  title,
  tagline,
  "overview": coalesce(overview, ""),
  "destinations": coalesce(count(destinations), 0),
  "days": coalesce(count(schedule), 0)
}
`

const variants = cva('', {
  variants: {
    variant: {
      default: '',
      flipped: '',
    },
  },
  defaultVariants: { variant: 'default' },
})

const textColVariants = cva(
  'flex flex-col gap-[2em] clamp-[pt,50px,200px,390px,2000px] mb-(--clamp-main-bottom-space) split-text-container col-span-full',
  {
    variants: {
      variant: {
        default: 'lg:col-[2/6] xl:col-[2/5]',
        flipped: 'lg:col-[8/12] xl:col-[9/12]',
      },
    },
  },
)

const portraitColVariants = cva(
  'clamp-[mb,20px,50px] clamp-[mt,20px,30px] max-h-dvh col-span-full',
  {
    variants: {
      variant: {
        default: 'lg:col-[7/13] xl:col-[6/13] justify-self-end',
        flipped: 'lg:col-[1/7] xl:col-[1/8] row-start-1',
      },
    },
  },
)

const { itinerary, variant, class: cls, ...attrs } = Astro.props
---

<article class:list={['flex flex-col', cls]} {...attrs}>
  <figure class="w-full relative clamp-[py,200px,350px,370px,2560px]">
    <Picture
      pictureClass="block absolute inset-0"
      class="size-full object-cover brightness-50"
      src={itinerary.cover}
      sources={fullscreenSources}
      alt={itinerary.cover.alt ?? ''}
    />
    <figcaption
      class="relative w-[62%] mx-auto max-w-250 flex flex-col gap-[30px] items-center justify-center *:text-inverted *:text-center itineraryPosterHero invisible"
    >
      <h3 class="text-masthead">{itinerary.title}</h3>
      <div class="flex flex-col items-center gap-[5px]">
        <p class="text-byline">{itinerary.tagline}</p>
        <p class="text-h4">{itinerary.days} days, {itinerary.destinations} destinations</p>
      </div>
    </figcaption>
  </figure>
  <div class="main-grid main-container">
    <div class={textColVariants({ variant })}>
      <p>{itinerary.overview}</p>
      <RollLink href={`/itineraries/${itinerary.slug}`}>View Itinerary</RollLink>
    </div>

    <div class={portraitColVariants({ variant })}>
      {
        itinerary.portrait && (
          <Picture
            src={itinerary.portrait}
            alt={itinerary.portrait.alt ?? ''}
            class="object-cover aspect-page max-h-full max-w-full"
          />
        )
      }
    </div>
  </div>
</article>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'

  gsap.registerPlugin(ScrollTrigger, SplitText)

  gsap.utils.toArray<HTMLElement>('.itineraryPosterHero').forEach((container) => {
    let h3 = container.querySelector('h3')!,
      rest = container.querySelectorAll('p')

    gsap
      .timeline({
        scrollTrigger: {
          trigger: container,
          start: 'top bottom',
          once: true,
        },
        delay: 0.2,
      })
      .set(container, { autoAlpha: 1 })
      .from(SplitText.create(h3, { type: 'lines,chars', autoSplit: true }).chars, {
        autoAlpha: 0,
        ease: 'power4.out',
        stagger: { each: 0.03, ease: 'power2.in' },
      })
      .from(rest, { yPercent: 20, autoAlpha: 0, stagger: 0.2 }, '-=.2')
  })
</script>
