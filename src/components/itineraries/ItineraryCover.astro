---
import Picture from '@/Picture.astro'
import RollLink from '@/RollLink.astro'
import Theme from '@/Theme.astro'
import type { HTMLAttributes } from 'astro/types'
import type { Itinerary, Theme as ThemeType } from 'sanity.types'

interface Props extends HTMLAttributes<'div'> {
  itinerary: NonNullable<Pick<Itinerary, 'slug' | 'cover' | 'title' | 'tagline' | 'price'>> & {
    themes: ThemeType[]
  }
  flipped?: boolean
}

const { itinerary, flipped, class: cls, ...attrs } = Astro.props
---

<div
  class:list={['grid max-lg:gap-y-[25px] lg:grid-cols-2 lg:aspect-cover max-h-dvh w-full', cls]}
  {...attrs}
>
  <Picture
    class:list={['object-cover h-full w-full', flipped ? 'order-2' : 'order-1']}
    pictureClass="min-h-0 block"
    src={itinerary.cover}
    sources={[
      { media: '(min-width:0px)', sizes: '50vw', widths: [300, 600, 1200], aspect: 17 / 22 },
    ]}
  />
  <div
    class:list={[
      'flex flex-col gap-5 lg:gap-[50px] lg:items-center lg:justify-center lg:place-self-center main-container',
      flipped ? 'order-1' : 'order-2',
    ]}
  >
    <div class="flex flex-col lg:items-center gap-2.5">
      <h3 class="text-h3 max-lg:leading-none lg:text-masthead lg:text-center">{itinerary.title}</h3>
      <p class="text-byline lg:text-center">{itinerary.tagline}</p>
    </div>
    <div class="flex flex-col lg:items-center gap-5">
      <div class="max-lg:hidden flex gap-10">
        {itinerary.themes.map((th) => <Theme class="size-[55px]" theme={th} />)}
      </div>
      <p class="text-h3">{itinerary.price}</p>
    </div>
    <RollLink href={`/itineraries/${itinerary.slug.current}`}>Explore Details</RollLink>
  </div>
</div>
