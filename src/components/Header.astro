---
import Hairline from '@/Hairline.astro'
import Mandala from '@/Mandala.astro'
import RollButton from '@/RollButton.astro'
import RollLink from '@/RollLink.astro'

const gap = 'clamp-[gap,15px,25px]',
  px = 'clamp-[px,15px,25px]'

const navItems = ['journal', 'destinations', 'itineraries']

interface Props {
  class?: string
  waitForReveal?: boolean
  variant: 'default' | 'mono'
}

const { class: cls, waitForReveal, variant = 'default' } = Astro.props
---

<header
  id="pageHeader"
  data-wait-for-reveal={waitForReveal || undefined}
  class:list={[
    'fixed top-0 left-0 right-0 clamp-[h,60px,100px] flex justify-between z-30',
    px,
    cls,
  ]}
>
  <div id="headerLogo" class="invisible flex items-center">
    <a href="/" aria-label="Home"
      ><Mandala
        inert
        color={variant === 'default' ? 'var(--color-inverted)' : 'var(--color-text)'}
        class="clamp-[size,40px,60px]"
      /></a
    >
  </div>
  <nav id="headerNav" aria-label="Main navigation" class:list={['flex h-full', gap]}>
    <ul class:list={['flex h-full', gap]}>
      {
        navItems.map((n) => (
          <li class="invisible h-full flex items-center">
            <RollLink href={`/${n}`} variant={variant === 'default' ? 'title' : 'mono'}>
              {n}
            </RollLink>
          </li>
        ))
      }
    </ul>
    <Hairline direction="y" id="header-hairline-cta" variant={variant} />
    <div class="flex items-center invisible" id="headerCTA">
      <RollButton {...variant === 'mono' ? { variant: 'mono' } : {}}>Inquire</RollButton>
    </div>
  </nav>
  <Hairline
    id="header-hairline-bottom"
    class="absolute left-0 right-0 -bottom-px"
    variant={variant}
  />
</header>

<script>
  import { clamp, lerp } from '~/lib/utils'
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const hlc = document.querySelector<HTMLElementTagNameMap['hair-line']>('#header-hairline-cta')!,
    hlb = document.querySelector<HTMLElementTagNameMap['hair-line']>('#header-hairline-bottom')!

  function hairlineDuration() {
    let t = clamp(402, 2560, window?.innerWidth ?? 0)
    return lerp(0.6, 1.6, t)
  }

  const duration = hairlineDuration()

  let playedOnce = false

  const navIn = gsap
    .timeline()
    .set('#headerNav li', { autoAlpha: 1 })
    .from('#headerNav li', { yPercent: -100, stagger: 0.16 })
    .from(
      '#headerCTA',
      {
        id: 'ctaIn',
        yPercent: () => (playedOnce ? 0 : -100),
        onStart: () => {
          playedOnce = true
          gsap.set('#headerCTA', { autoAlpha: 1 })
        },
      },
      '-=0.16',
    )
  const navOut = gsap.to('#headerNav li', { yPercent: -100 })

  const inTl = gsap
    .timeline({ paused: true, defaults: { ease: 'sine.out' } })
    .add(hlb.tl.tweenTo(1, { duration, ease: 'power3.out' }), 0)
    .add(hlc.tl.tweenTo(1, { duration, ease: 'power3.out' }), 0)
    .from(
      '#headerLogo',
      {
        id: 'logoIn',
        yPercent: () => (playedOnce ? 0 : -100),
        onStart: () => {
          gsap.set('#headerLogo', { autoAlpha: 1 })
        },
      },
      0,
    )
    .add(navIn, duration - navIn.duration())

  const outTl = gsap
    .timeline({ paused: true, defaults: { ease: 'sine.out' } })
    .add(hlb.tl.tweenTo(0, { duration, ease: 'power3.out' }), 0)
    .add(hlc.tl.tweenTo(0, { duration, ease: 'power3.out' }), 0)
    .add(navOut, 0)
  // .to('#headerLogo', { yPercent: -100 }, duration - 0.6)

  const header = document.getElementById('pageHeader')!
  const waitForReveal = header.hasAttribute('data-wait-for-reveal')

  if (waitForReveal) {
    window.addEventListener('heroRevealed', () => {
      inTl.play()
    })
  } else {
    inTl.progress(1)
  }

  let isScrolled = false

  window.addEventListener(
    'scroll',
    () => {
      const scrolled = window.scrollY > 10
      if (scrolled && !isScrolled) {
        isScrolled = true
        inTl.pause()
        outTl.restart()
      } else if (!scrolled && isScrolled) {
        isScrolled = false
        outTl.pause()
        navIn.getById('ctaIn')?.invalidate()
        inTl.getById('logoIn')?.invalidate()
        inTl.restart()
      }
    },
    { passive: true },
  )
</script>
