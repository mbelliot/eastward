---
import Hairline from '@/Hairline.astro'
import Mandala from '@/Mandala.astro'
import RollButton from '@/RollButton.astro'
import RollLink from '@/RollLink.astro'

const gap = 'clamp-[gap,15px,25px]',
  px = 'clamp-[px,15px,25px]'

const navItems = ['journal', 'destinations', 'itineraries']

const { class: cls } = Astro.props
---

<header
  class:list={[
    'fixed top-0 left-0 right-0 clamp-[h,60px,100px] flex justify-between items-center z-30',
    px,
    cls,
  ]}
>
  <div>
    <a href="/" aria-label="Home"><Mandala inert color="white" class="clamp-[size,40px,60px]" /></a>
  </div>
  <nav aria-label="Main navigation" class:list={['flex items-center h-full', gap]}>
    <ul class:list={['flex', gap]}>
      {
        navItems.map((n) => (
          <li>
            <RollLink href={`/${n}`} variant="title">
              {n}
            </RollLink>
          </li>
        ))
      }
    </ul>
    <Hairline direction="y" id="header-hairline-cta" />
    <RollButton>Inquire</RollButton>
  </nav>
  <Hairline id="header-hairline-bottom" class="absolute left-0 right-0 -bottom-px" />
</header>

<script>
  const hlc = document.querySelector('#header-hairline-cta') as any,
    hlb = document.querySelector('#header-hairline-bottom') as any
  hlc?.tl?.seek(1)
  hlb?.tl?.seek(1)
</script>
