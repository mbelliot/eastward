---
import IconButton from './IconButton.astro'
---

<slide-modal
  role="dialog"
  aria-modal="true"
  tabindex="-1"
  id="slideModal"
  class="invisible cursor-default fixed z-20 inset-0 bg-brand"
>
  <div class="main-grid main-container">
    <div class="flex flex-col col-span-full pt-25 h-screen gap-8 pb-16">
      <div class="relative flex-1 imgContainer"></div>
      <div class="main-grid px-0">
        <div class="col-span-11 textContainer *:text-inverted"></div>
        <div class="col-start-12 justify-self-end">
          <IconButton aria-label="Close modal" class="-rotate-45 p-5 border-inverted">
            <span class="bg-inverted w-6 h-px"></span>
            <span class="bg-inverted w-6 h-px absolute rotate-90 origin-center"></span>
          </IconButton>
        </div>
      </div>
    </div>
  </div>
</slide-modal>

<script>
  import gsap from 'gsap'
  import { SplitText } from 'gsap/SplitText'
  import { lockScroll, releaseScroll } from '~/lib/utils'
  gsap.registerPlugin(SplitText)

  class SlideModal extends HTMLElement {
    connectedCallback() {
      this.querySelector('icon-button > button')?.addEventListener('click', () => {
        this.close()
      })
      this.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') this.close()
      })
    }

    close() {
      let modalFlex = this.querySelector('.flex'),
        tl = gsap.timeline({
          defaults: { duration: 0.6 },
          onComplete: () => {
            releaseScroll()
            gsap.set(this, { clearProps: 'all' })
            gsap.set(modalFlex, { clearProps: 'all' })

            this.querySelector('.imgContainer')!.innerHTML = ''
            this.querySelector('.textContainer')!.innerHTML = ''
          },
        })

      tl.to(modalFlex, { opacity: 0 }).to(
        this,
        {
          clipPath: 'inset(0 0 100% 0)',
        },
        '-=0.3',
      )
    }

    show(templateContent: DocumentFragment) {
      const imgContainer = this.querySelector('.imgContainer')!
      const textContainer = this.querySelector('.textContainer')!
      const clone = templateContent.cloneNode(true) as DocumentFragment
      const picture = clone.querySelector('picture')

      if (picture) {
        imgContainer.appendChild(picture)
      }
      textContainer.append(...clone.children)

      const img = imgContainer.querySelector('img')
      const lines = Array.from(textContainer.querySelectorAll('p')).flatMap(
        (p) =>
          SplitText.create(p, {
            type: 'lines',
          }).lines,
      )

      lockScroll()
      gsap
        .timeline({
          defaults: { ease: 'expo.out' },
          onComplete: () => {
            this.focus()
          },
        })
        .fromTo(
          this,
          { clipPath: 'inset(0 0 100% 0)', autoAlpha: 1 },
          { clipPath: 'inset(0 0 0% 0)', duration: 1.6 },
        )
        .fromTo(
          img,
          { clipPath: 'inset(0 0 100% 0)' },
          {
            clipPath: 'inset(0 0 0% 0)',
            duration: 1.2,
          },
          0.4,
        )
        .from(lines, { yPercent: 60, autoAlpha: 0, stagger: 0.1 }, '-=0.4')
        .from(this.querySelector('icon-button > button'), { opacity: 0, duration: 1.2 }, 0.4)
    }
  }
  customElements.define('slide-modal', SlideModal)

  declare global {
    interface HTMLElementTagNameMap {
      'slide-modal': SlideModal
    }
  }
</script>
