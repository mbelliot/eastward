---
import { sanityClient } from 'sanity:client'
import { defineQuery } from 'groq'
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import Picture, { fullscreenSources } from '@/Picture.astro'
import Content from '@/journal/Content.astro'
import JournalCard, { journalCardFragment } from '@/journal/JournalCard.astro'
import Divider from '@/Divider.astro'

export const getStaticPaths = (async () => {
  const journalSlugsQuery = defineQuery('*[_type == "journal"]{ slug }'),
    journals = await sanityClient.fetch(journalSlugsQuery)

  return journals.map(({ slug }) => ({ params: { slug: slug.current } }))
}) satisfies GetStaticPaths

const journalQuery = defineQuery(`*[_type == 'journal' && slug.current == $slug][0] {
  ...,
 itinerary-> {
  slug,
  title,
  curator-> {
    slug,
    name,
    portrait
   }
 },
 "related": *[_type == 'journal'&&_id != ^._id] | order(
   select(
     publishedAt > ^.publishedAt => publishedAt - ^.publishedAt,
     ^.publishedAt - publishedAt
   )
 )[0...2] ${journalCardFragment}
  }`)

const journal = (await sanityClient.fetch(journalQuery, Astro.params))!
---

<Layout
  title={journal.title}
  class="bg-black **:text-inverted"
  footerClass="bg-black border-t border-white/20"
>
  <Picture
    pictureClass="block absolute inset-0 bottom-auto h-dvh overflow-clip"
    class="size-full object-cover"
    sources={fullscreenSources}
    src={journal.cover}
    alt={journal.cover.alt ?? ''}
  />
  <div class="relative mt-[40dvh]">
    <article>
      <header class="bg-linear-to-t from-black via-black/80 to-black/0">
        <div class="max-w-[1280px] mx-auto main-container">
          <h1
            class="font-title clamp-[text,44px,80px] tracking-[-.04em] leading-[1.18] text-balance"
          >
            {journal.title}
          </h1>
          <p class="text-byline mt-[20px] max-w-[600px]">{journal.excerpt}</p>
        </div>
      </header>
      <div class="bg-black clamp-[pt,20px,70px]">
        <div class="mx-auto max-w-[1280px] main-container">
          <div class="relative flex lg:items-start justify-between max-lg:flex-col">
            <div class="journalContent max-w-180">
              <Content content={journal.content} />
            </div>
            {
              journal.itinerary?.curator && (
                <a
                  class="block sticky top-[150px]"
                  href={`/curator/${journal.itinerary.curator.slug.current}`}
                >
                  <aside class="max-lg:mt-20">
                    <Picture
                      pictureClass="block max-w-40 aspect-page-fixed max-lg:mx-auto"
                      class="object-cover size-full"
                      sources={[{ widths: [400], media: '(min-width:0px)' }]}
                      alt={journal.itinerary.curator.name}
                      src={journal.itinerary.curator.portrait}
                    />
                    <p class="mt-2 text-center">{journal.itinerary.curator.name}</p>
                  </aside>
                </a>
              )
            }
          </div>
          <footer class="pb-25">
            {
              journal.itinerary && (
                <div class="flex flex-col items-center text-center gap-5 main-spacing">
                  <p>Explore the full itinerary:</p>
                  <a
                    class="text-h2 underline"
                    href={`/itineraries/${journal.itinerary.slug.current}`}
                  >
                    {journal.itinerary.title}
                  </a>
                </div>
              )
            }
            <Divider variant="inverted" class="clamp-[my,20px,50px]" />
            <div class="flex justify-between clamp-[gap,10px,30px]">
              {
                journal.related
                  .sort(
                    (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
                  )
                  .map((j) => <JournalCard journal={j} variant="inverted" />)
              }
            </div>
          </footer>
        </div>
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .journalContent p {
    line-height: 1.8;
    font-size: 22px;
    opacity: 0.85;
  }

  .journalContent p + p {
    margin-top: 0.8lh;
  }
</style>
