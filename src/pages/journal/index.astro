---
import { defineQuery } from 'groq'
import { sanityClient } from 'sanity:client'
import Divider from '@/Divider.astro'
import Layout from '~/layouts/Layout.astro'
import { journalCardFragment } from '@/journal/JournalCard.astro'
import JournalGrid from '@/journal/JournalGrid.astro'

const journalIndexQuery = defineQuery(
  `*[_type == 'journal'] | order(publishedAt desc) ${journalCardFragment}`,
)

const journals = await sanityClient.fetch(journalIndexQuery, {})!
---

<Layout variant="mono" title="Journal">
  <div class="max-w-[1400px] main-container mx-auto">
    <div class="clamp-[h,350px,450px,390px,1280px] flex flex-col justify-end pb-[30px]">
      <h1 class="text-billboard">Journal</h1>
      <p class="text-byline mb-[10px]">Stories and reflections from our curated travels</p>
      <Divider />
    </div>
    <JournalGrid journals={journals} class="mb-(--clamp-main-bottom-space)" />
  </div>
</Layout>
