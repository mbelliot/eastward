---
import { sanityClient } from "sanity:client"
import type { GetStaticPaths } from "astro"
import { defineQuery } from "groq"
import Layout from "~/layouts/Layout.astro"

export const getStaticPaths = (async () => {
	let dests = await sanityClient.fetch('*[_type == "destination"]')

	return dests.map(({ slug }) => ({ params: { slug: slug.current } }))
}) satisfies GetStaticPaths

let { params } = Astro

let destinationQuery = defineQuery(
	'*[_type=="destination" && slug.current == $slug][0]',
)
let dest = await sanityClient.fetch(destinationQuery, params)

// sanity typegen chokes on return here
// if (!dest) return Astro.rewrite("/404")
---

<Layout>{dest?.name} </Layout>
