---
import { sanityClient } from 'sanity:client'
import type { GetStaticPaths } from 'astro'
import { defineQuery } from 'groq'
import Button from '@/Button.astro'
import Divider from '@/Divider.astro'
import RollLink from '@/RollLink.astro'
import SectionTitle from '@/SectionTitle.astro'
import TextBlock from '@/TextBlock.astro'
import Theme from '@/Theme.astro'
import Layout from '~/layouts/Layout.astro'
import Attractions from '@/destinations/Attractions.astro'
import Picture, { fullscreenSources } from '@/Picture.astro'

export const getStaticPaths = (async () => {
  let dests = await sanityClient.fetch('*[_type == "destination"]')

  return dests.map(({ slug }) => ({ params: { slug: slug.current } }))
}) satisfies GetStaticPaths

let { params } = Astro

let destinationQuery = defineQuery(
  `*[_type=="destination" && slug.current == $slug][0] {
      ...,
      themes[]->,
      "numItineraries": count(*[_type == 'itinerary' && references(^._id)])
}`,
)
let dest = (await sanityClient.fetch(destinationQuery, params))!

// sanity typegen chokes on return here
// code path unreachable on SSG, problematic on SSR
//
// if (!dest) return Astro.rewrite("/404")
---

<Layout title={dest.name}>
  <section class="relative main-grid main-container h-dvh items-end">
    {
      dest.cover && (
        <Picture
          class="absolute inset-0 object-cover w-full h-full object-center brightness-70"
          alt={dest.cover?.alt ?? ''}
          src={dest.cover}
          sources={fullscreenSources}
          loading="eager"
          decoding="async"
        />
      )
    }
    <div class="relative col-[2/13] mb-[8vh] flex flex-col gap-1.5">
      <div aria-hidden="true" class="absolute inset-0 -left-8 bg-inverted w-2"></div>
      <p class="text-byline text-inverted clamp-[text,24px,30px,375px,2400px] leading-none">
        {dest.tagline}
      </p>
      <h1 class="text-masthead clamp-[text,60px,240px,375px,2400px] text-inverted">
        {dest.name}
      </h1>
      <ul class="flex items-center gap-2.5 text-label text-inverted leading-none pt-8">
        <li>{dest.country}</li>
        <li aria-hidden="true" class="size-1.5 rounded-full bg-inverted"></li>
        <li>
          {dest.numItineraries}
          {dest.numItineraries === 1 ? 'itinerary' : 'itineraries'}
        </li>
      </ul>
    </div>
  </section>
  <section class="main-grid main-container h-dvh mb-[100px]">
    <div class="col-span-6 clamp-[pt,20px,30px] min-h-0">
      {
        dest.portrait && (
          <Picture
            class="w-full h-full object-cover"
            src={dest.portrait}
            alt={dest.portrait?.alt ?? ''}
            sources={[
              { media: '(min-width: 0px)', widths: [400, 800], aspect: 9 / 16, sizes: '100vw' },
            ]}
          />
        )
      }
    </div>
    <div class="mt-[150px] col-[8/12] flex flex-col items-start gap-[2em]">
      <h2 class="text-h2">{dest.tagline}</h2>
      <div class="flex flex-col gap-[1em]">
        <TextBlock class="text-balance" text={dest.appeal ?? ''} />
      </div>
      <RollLink href="#itineraries">View itineraries</RollLink>
    </div>
  </section>
  <Divider />
  <section class="main-grid main-container main-margin">
    <h2 class="text-h2 col-[2/6] mb-5">Curated Perspectives</h2>
    <div class="col-[2/6]">
      <p class="text-balance">
        True luxury lies in the meaning we find beneath the surface. Our curators identify the
        essential threads that weave a location’s identity, providing a structured framework for
        your exploration. We don’t just show you a place; we reveal the themes that define its soul.
      </p>
    </div>
    <div class="col-[7/12] flex flex-col gap-5">
      {
        (dest.themes ?? []).map((theme, i) => (
          <>
            {i > 0 && <Divider />}
            <div class="flex gap-[30px] items-center">
              <Theme class="size-[50px]" theme={theme} />
              <p>{theme.name}</p>
            </div>
          </>
        ))
      }
    </div>
  </section>
  <Divider />
  {
    dest.attractions && (
      <section class="main-grid main-container main-margin overflow-x-clip" data-focus-reel-root>
        <div class="col-[9/12] flex flex-col items-start gap-5 z-10">
          <SectionTitle
            title="The Sights"
            desc="The iconic silhouettes that anchor the local horizon."
          />
          <div class="flex gap-5">
            <Button name="arrow-left" data-previous-slide aria-label="Previous slide" />
            <Button name="arrow-right" data-next-slide aria-label="Next slide" />
          </div>
        </div>
        <Attractions class="col-span-full" attractions={dest.attractions} />
      </section>
    )
  }
  <Divider />
  {
    dest.activities && (
      <section class="main-grid main-container main-margin">
        <div class="col-[2/6]">
          <SectionTitle
            title="The Moments"
            desc="The unscripted grace found in the rituals of the everyday."
          />
        </div>
        <div class="col-[2/13]">Hello</div>
      </section>
    )
  }
</Layout>
