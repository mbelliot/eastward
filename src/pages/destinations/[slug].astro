---
import { sanityClient } from 'sanity:client'
import type { GetStaticPaths } from 'astro'
import { defineQuery } from 'groq'
import Button from '@/Button.astro'
import Divider from '@/Divider.astro'
import RollLink from '@/RollLink.astro'
import SectionTitle from '@/SectionTitle.astro'
import TextBlock from '@/TextBlock.astro'
import Theme from '@/Theme.astro'
import Layout from '~/layouts/Layout.astro'
import Attractions from '@/destinations/Attractions.astro'
import Picture, { fullscreenSources } from '@/Picture.astro'
import Activities from '@/destinations/Activities.astro'
import FlexSlider from '@/FlexSlider.astro'
import OverlayCard from '@/OverlayCard.astro'
import RichText from '@/RichText.astro'
import ItineraryCover from '@/itineraries/ItineraryCover.astro'
import DestinationFAQs from '@/destinations/DestinationFAQs.astro'
import TestimonialSection from '@/testimonials/TestimonialSection.astro'
import NewsletterForm from '@/forms/NewsletterForm.astro'
import DestinationPolaroid from '@/destinations/DestinationPolaroid.astro'

export const getStaticPaths = (async () => {
  const destinationSlugsQuery = defineQuery('*[_type == "destination"]{ slug }'),
    dests = await sanityClient.fetch(destinationSlugsQuery)

  return dests.map(({ slug }) => ({ params: { slug: slug.current } }))
}) satisfies GetStaticPaths

const { params } = Astro

const destinationQuery = defineQuery(
  `*[_type=="destination" && slug.current == $slug][0] {
      ...,
      cover {
        ...,
        "lqip": asset->metadata.lqip
      },
      themes[]->,
      "testimonials": *[_type == 'testimonial' && references(^._id)],
      "itineraries": *[_type == 'itinerary' && references(^._id)] {
        slug,
        title,
        tagline,
        cover,
        price,
        themes[0..2]->
      }
}`,
)
const dest = (await sanityClient.fetch(destinationQuery, params))!

// sanity typegen chokes on return here
// code path unreachable on SSG, problematic on SSR
//
// if (!dest) return Astro.rewrite("/404")
---

<Layout title={dest.name}>
  <section id="destinationHeroContainer" class="relative main-grid main-container h-dvh items-end">
    <Picture
      id="heroImg"
      class="object-cover size-full object-center brightness-70"
      pictureClass="absolute inset-0 overflow-clip"
      alt={dest.cover?.alt ?? ''}
      src={dest.cover}
      lqip={dest.cover.lqip ?? undefined}
      sources={fullscreenSources}
      loading="eager"
      decoding="sync"
      fetchpriority="high"
    />
    <div
      class="relative col-[2/13] mb-[8vh] flex flex-col gap-1.5 *:invisible"
      id="destinationHero"
    >
      <div data-accent-line aria-hidden="true" class="absolute inset-0 -left-8 bg-inverted w-2">
      </div>
      <p class="text-byline text-inverted clamp-[text,24px,30px,375px,2400px] leading-none">
        {dest.tagline}
      </p>
      <h1 class="text-masthead clamp-[text,60px,240px,375px,2400px] text-inverted">
        {dest.name}
      </h1>
      <ul class="flex items-center gap-2.5 text-label text-inverted leading-none pt-8">
        <li>{dest.country}</li>
        <li aria-hidden="true" class="size-1.5 rounded-full bg-inverted"></li>
        <li>
          {dest.itineraries.length}
          {dest.itineraries.length === 1 ? 'itinerary' : 'itineraries'}
        </li>
      </ul>
    </div>
  </section>
  <section class="grid lg:main-grid main-container xl:min-h-dvh pb-25">
    <div
      class="col-span-full max-lg:row-start-2 lg:col-span-6 clamp-[pt,20px,30px] min-h-0 max-h-dvh relative flex flex-col justify-end"
    >
      {
        dest.portrait && (
          <Picture
            pictureClass="block min-h-0 max-h-full w-full aspect-page max-lg:mt-12.5"
            class="size-full object-cover"
            src={dest.portrait}
            alt={dest.portrait?.alt ?? ''}
            sources={[
              { media: '(min-width: 0px)', widths: [400, 800], aspect: 9 / 16, sizes: '100vw' },
            ]}
          />
        )
      }
    </div>
    <div
      class="clamp-[mt,50px,150px] lg:col-[8/12] flex flex-col items-start gap-[2em] split-text-container"
    >
      <h2 class="text-h2">{dest.tagline}</h2>
      <div data-lines-container class="flex flex-col gap-[1em]">
        <TextBlock class="text-balance" text={dest.appeal ?? ''} />
      </div>
      <RollLink href="#itineraries">View itineraries</RollLink>
    </div>
  </section>
  <Divider />
  <section class="max-md:gap-y-10 main-grid main-container main-margin split-text-container">
    <h2 class="text-h2 col-span-full lg:col-[2/6] mb-5">Curated Perspectives</h2>
    <div class="col-span-full lg:col-[2/6]" data-lines-container="">
      <p class="text-balance">
        True luxury lies in the meaning we find beneath the surface. Our curators identify the
        essential threads that weave a location’s identity, providing a structured framework for
        your exploration. We don’t just show you a place; we reveal the themes that define its soul.
      </p>
    </div>
    <div class="col-span-full lg:col-[7/12] flex flex-col gap-5 split-text-container">
      {
        (dest.themes ?? []).map((theme, i) => (
          <>
            {i > 0 && <Divider />}
            <div class="flex gap-[30px] items-center">
              <Theme class="size-[50px]" theme={theme} />
              <p>{theme.name}</p>
            </div>
          </>
        ))
      }
    </div>
  </section>
  {
    dest.attractions && (
      <>
        <Divider />
        <section class="main-grid main-container main-margin" data-focus-reel-root>
          <div class="col-[9/12] flex flex-col items-start gap-5 z-10">
            <SectionTitle
              title="The Sights"
              desc="The iconic silhouettes that anchor the local horizon."
            />
            <div class="flex gap-5">
              <Button name="arrow-left" data-previous-slide aria-label="Previous slide" />
              <Button name="arrow-right" data-next-slide aria-label="Next slide" />
            </div>
          </div>
          <Attractions class="col-span-full" attractions={dest.attractions} />
        </section>
      </>
    )
  }
  {
    dest.activities && (
      <>
        <Divider />
        <section class="main-grid main-container main-margin">
          <div class="col-[2/6]">
            <SectionTitle
              title="The Moments"
              desc="The unscripted grace found in the rituals of the everyday."
            />
          </div>
          <div class="clamp-[mt,20px,50px] clamp-[gap-y,20px,50px] grid grid-cols-subgrid row-start-2 col-span-full">
            <Activities activities={dest.activities} />
          </div>
        </section>
      </>
    )
  }
  {
    dest.foods && (
      <>
        <Divider />
        <section class="main-grid main-container main-margin" data-flex-slider-root>
          <div class="flex gap-5 col-[2/8] items-end">
            <Button name="arrow-left" data-previous-slide aria-label="Previous slide" />
            <Button name="arrow-right" data-next-slide aria-label="Next slide" />
          </div>
          <div class="col-[9/12] flex flex-col items-start gap-5 z-10">
            <SectionTitle
              title="The Flavors"
              desc="An aromatic heritage told through ancestral culinary craft."
            />
          </div>
          <FlexSlider class="col-[2/13] pt-7.5 [--blur:12px]" trackClass="clamp-[gap-x,20px,25px]">
            {dest.foods.map((food) => (
              <OverlayCard class="aspect-3/4 clamp-[w,300px,512px,390px,2000px] foodCard [--blur:40px]">
                <h4 class="text-h4 blur-(--blur)" slot="title">
                  {food.title}
                </h4>
                <Picture
                  sources={[{ media: '(min-width:0px)', widths: [512], aspect: 3 / 4 }]}
                  src={food.image}
                  slot="image"
                />
                <div class="blur-(--blur)">
                  <RichText class="blur-(--blur)" text={food.body} />
                </div>
              </OverlayCard>
            ))}
          </FlexSlider>
        </section>
      </>
    )
  }
  {
    dest.testimonials?.length && (
      <TestimonialSection testimonials={dest.testimonials} bgSrc={dest.cover} />
    )
  }
  <div aria-hidden="true" id="itineraries"></div>
  {
    dest.itineraries?.length &&
      dest.itineraries.map((itn, i) => <ItineraryCover itinerary={itn} flipped={Boolean(i % 2)} />)
  }
  <section class="main-container main-grid h-dvh place-items-center">
    <div class="col-[2/12] lg:col-[2/6]">
      <NewsletterForm />
    </div>
    <div class="max-lg:hidden col-[7/13] place-self-stretch mr-[-10vw] my-[5dvh]">
      <DestinationPolaroid slug={dest.slug.current} />
    </div>
  </section>
  <section class="main-container main-margin">
    <DestinationFAQs />
  </section>
</Layout>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'

  gsap.registerPlugin(ScrollTrigger, SplitText)

  const hero = document.getElementById('destinationHero')!
  const heroReveal = gsap.from(hero.querySelectorAll('p, h1, ul'), {
    autoAlpha: 0,
    y: 30,
    stagger: 0.2,
  })

  gsap.timeline().add(heroReveal).fromTo(
    hero.querySelector('[data-accent-line]'),
    { autoAlpha: 0.2, clipPath: 'inset(0 0 100% 0)' },
    {
      autoAlpha: 1,
      clipPath: 'inset(0 0 0% 0)',
      duration: heroReveal.duration(),
      ease: 'power3.out',
    },
    0,
  )

  gsap.to('#heroImg', {
    yPercent: 15,
    scrollTrigger: {
      scrub: true,
      start: 'top top',
      end: 'bottom top',
      trigger: '#destinationHeroContainer',
    },
  })

  ScrollTrigger.batch('.foodCard', {
    once: true,
    start: 'bottom bottom',
    onEnter: (batch) => {
      gsap.to(batch, { '--blur': '0px', duration: 0.6, stagger: 0.2, delay: 0.2, ease: 'sine.out' })
    },
  })
</script>
