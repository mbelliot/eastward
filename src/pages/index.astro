---
import Hairline from "@/Hairline.astro"
import Icon from "@/Icon.astro"
import RollButton from "@/RollButton.astro"
import RollLink from "@/RollLink.astro"
import Layout from "~/layouts/Layout.astro"
---

<Layout>
	<div class="h-25 bg-black flex items-center">
		<Hairline />
	</div>
	<h1 class="text-masthead w-3xl">Welcome to Eastward</h1>
	<RollButton>Hello</RollButton>
	<RollButton variant="dimmed" size="sm">Hello</RollButton>
	<RollButton variant="outline">Hello</RollButton>
	<RollButton variant="outline" size="sm">Hello</RollButton>
	<RollButton variant="plain">Hello</RollButton>
	<RollLink variant="title" class="text-text">Roll</RollLink>
	<RollLink>Roll</RollLink>
	<RollLink>Hello you</RollLink>
	<Icon name="Car" class="stroke-tint" />
</Layout>
