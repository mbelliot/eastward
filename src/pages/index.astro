---
import { defineQuery } from 'groq'
import { sanityClient } from 'sanity:client'
import Mandala from '@/Mandala.astro'
import Layout from '~/layouts/Layout.astro'
import { Image } from 'astro:assets'
import AttractionsSection from '@/destinations/AttractionsSection.astro'
import Divider from '@/Divider.astro'
import Laurels from '@/Laurels.astro'
import ItineraryPoster, { itineraryPosterFragment } from '@/itineraries/ItineraryPoster.astro'
import FeatureSection from '@/FeatureSection.astro'
import Theme from '@/Theme.astro'
import JournalGrid from '@/journal/JournalGrid.astro'
import SectionTitle from '@/SectionTitle.astro'
import Feature from '@/itineraries/Feature.astro'
import NewsletterForm from '@/forms/NewsletterForm.astro'
import Details from '@/Details.astro'
import FCity from '$/fcity.avif'
import Thres from '$/threshold.avif'

const indexPageQuery = defineQuery(`{
  "featuredDestinations": *[_type == "destination" && featured] {
    cover,
    "attractions": attractions[featured] {
      ...,
      "location": ^.name,
      "country": ^.country
    }
  },
  "featuredItineraries": *[_type == "itinerary" && featured] ${itineraryPosterFragment},
  "themes": *[_type == 'theme'],
  "journals": *[_type == 'journal'] | order(publishedAt desc)[0..2],
  "features": *[_type == 'feature']
  }`)

const { features, journals, themes, featuredDestinations, featuredItineraries } =
  (await sanityClient.fetch(indexPageQuery, {}))!
---

<Layout isIndexPage>
  <div class="relative h-dvh overflow-clip">
    <section class="size-full relative h-[200dvh]">
      <div id="heroVidContainer" class="h-dvh sticky top-0 overflow-clip">
        <video
          muted
          loop
          autoplay
          playsinline
          class="absolute inset-0 size-full overflow-clip object-cover pointer-events-none"
          id="heroVid"
        >
          <source src="https://objects.elliotli.dev/0111.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="absolute inset-0 bottom-auto h-dvh grid place-items-center">
        <div
          id="heroText"
          class="flex flex-col w-[70vw] max-w-350 items-center *:text-inverted *:text-center gap-[15px]"
        >
          <h1
            class="font-title clamp-[text,82px,200px,390px,2000px] uppercase tracking-[-0.06em] leading-[90%] invisible"
          >
            Journey to <span class="whitespace-nowrap">the East</span>
          </h1>
          <p class="text-byline invisible">
            Curated experiences across Asia’s most iconic destinations and living traditions.
          </p>
        </div>
      </div>
    </section>
    <div id="loading" class="absolute inset-0 bg-brand grid place-items-center text-inverted z-50">
      <Mandala class="size-50 md:size-[250px]" color="white" />
    </div>
  </div>
  <section class="main-grid main-container relative">
    <div
      class="max-lg:col-span-full col-[2/5] flex flex-col gap-10 lg:*:max-w-[500px] clamp-[pt,50px,200px] clamp-[pb,25px,100px] split-text-container"
    >
      <h2 class="text-h2">Asia, for those who want to be changed by it</h2>
      <p>
        Much of Asia is seen, very little of it is felt. Tailored for those who seek depth over
        distance, our journeys move between cultures preserved for centuries and cities inventing
        what comes next. This is Asia as it's rarely encountered, and never forgotten.
      </p>
    </div>
    <div
      class="h-dvh col-span-full lg:col-[6/13] relative overflow-visible grid grid-cols-subgrid grid-rows-[auto_auto] content-end pb-[50px] gap-y-7.5"
    >
      <div
        aria-hidden="true"
        class="absolute inset-0 clamp-[mr,-20px,-50px] clamp-[ml,-15px,-20px] pointer-events-none"
      >
        <Image
          class="size-full object-cover"
          layout="constrained"
          src={FCity}
          alt="The Forbidden City"
        />
        <div
          class="absolute inset-0 top-auto h-[60%] bg-linear-to-t from-black via-black/30 to-transparent backdrop-blur-[2px]"
          style="mask-image: linear-gradient(to bottom, transparent, rgba(0,0,0,0.5), black); -webkit-mask-image: linear-gradient(to bottom, transparent, rgba(0,0,0,0.5), black);"
        >
        </div>
        <p class="image-label absolute left-0 top-[8%] lg:top-[28%]">
          A private gathering in the Forbidden City, where snow-laced roofs awaken at sunrise, and
          centuries unfold in gold.
        </p>
      </div>
      <div
        id="laurels"
        class="col-[2/13] lg:col-[5/8] max-w-[600px] relative justify-self-end flex flex-col gap-7.5 items-end *:text-inverted *:leading-[1.4]"
      >
        <Laurels class="gap-5" />
        <p class="text-end invisible">
          For over a decade, Eastward has been creating journeys defined by depth, discretion, and
          rare access. We believe travel should do more than impress for a moment; it should stay
          with you for a lifetime.
        </p>
      </div>
      <div class="introInfo invisible grid grid-cols-subgrid col-span-full justify-items-end">
        <div
          class="relative text-inverted col-[1/7] lg:col-[4/6] max-w-[300px] *:leading-[1.4] *:text-end"
        >
          <p class="font-medium uppercase">About</p>
          <p class="">
            Learn more about our team and our philosophy <a class="underline" href="/about">here</a
            >.
          </p>
        </div>
        <div
          class="introInfo invisible relative *:text-inverted col-[7/13] lg:col-[6/8] max-w-[300px] *:leading-[1.4] *:text-end"
        >
          <p class="font-medium uppercase">Contact</p>
          <p>Call or WhatsApp us at <span class="whitespace-nowrap">+852 5555 0123</span></p>
        </div>
      </div>
    </div>
  </section>
  <div aria-hidden="true" class="clamp-[h,50px,150px]"></div>
  {
    featuredDestinations?.length && (
      <>
        <Divider />
        <AttractionsSection
          title="Icons of Asia"
          desc="The landmarks that will stay with you."
          attractions={featuredDestinations
            .flatMap((dest) => dest.attractions ?? [])
            .sort(() => 0.5 - Math.random())}
        />
      </>
    )
  }
  {
    featuredItineraries?.length &&
      featuredItineraries.map((itn, i) => (
        <ItineraryPoster itinerary={itn} variant={i % 2 > 0 ? 'flipped' : 'default'} />
      ))
  }
  <Divider />
  <FeatureSection title="Experiences">
    <p slot="desc">
      Explore our curated collection of immersive activities, tailored to reflect the way you choose
      to see the world.
    </p>
    <>
      {
        (themes ?? []).map((theme, i) => (
          <>
            {i > 0 && <Divider />}
            <div class="flex gap-[30px] items-center">
              <Theme class="size-[50px]" theme={theme} />
              <p>{theme.name}</p>
            </div>
          </>
        ))
      }
    </>
  </FeatureSection>
  <Divider />
  <section class="main-grid main-container main-spacing">
    <SectionTitle
      class="col-span-full lg:col-[9/13]"
      title="From the Field"
      desc="Latest reports from our curators"
    />
    <div class="col-span-full pt-[50px]">
      <JournalGrid journals={journals} />
    </div>
  </section>
  <Divider />
  <FeatureSection title="Amenities">
    <p slot="desc">
      Travel with us and everything you need is already taken care of — thoughtful amenities
      included, so you can focus on the destination, not the details.
    </p>
    <>
      {
        features.map((feat, i) => (
          <>
            {i > 0 && <Divider />}
            <Feature feature={feat} />
          </>
        ))
      }
    </>
  </FeatureSection>
  <section class="main-container main-grid h-dvh place-items-center">
    <div class="col-[2/12] lg:col-[2/6]">
      <NewsletterForm />
    </div>
    <div class="max-lg:hidden col-[7/13] place-self-stretch mr-[-10vw] my-[5dvh] relative">
      <Image
        src={Thres}
        layout="constrained"
        alt="Lantern-lit temple"
        class="size-full object-cover"
      />
      <p class="image-label absolute left-0 bottom-[8%] lg:bottom-[13%]">
        A lantern-lit threshold at the edge of the sacred, where red lacquer holds centuries of
        whispered prayers.
      </p>
    </div>
  </section>
  <Divider />
  <section class="main-container main-spacing">
    <div class="flex flex-col mx-auto gap-12.5 w-[70ch]">
      <h3 class="text-h2">Frequently Asked Questions</h3>
      <div class="flex flex-col">
        <Details summary="What kind of journeys do you design?">
          <p>
            We create privately guided journeys across Asia for travelers who care about cultural
            depth, thoughtful pacing, and a stronger sense of place. The emphasis is on fewer,
            better-chosen experiences rather than trying to see everything at once.
          </p>
        </Details>

        <Details summary="Are these trips private or group based?">
          <p>
            These journeys are designed as private experiences, which allows the routing, rhythm,
            and level of support to feel more personal. That makes it easier to shape the trip
            around your interests instead of asking you to fit a fixed group schedule.
          </p>
        </Details>

        <Details summary="Can you tailor the itinerary to our interests?">
          <p>
            Yes. Each journey can be adjusted around what matters most to you, whether that is
            history, architecture, food, quieter stays, family pacing, or a better balance between
            iconic stops and less expected moments.
          </p>
        </Details>

        <Details summary="How do we start planning?">
          <p>
            The process usually starts with a conversation about where you want to go, how you like
            to travel, and what kind of experience you want the journey to leave you with. From
            there, the itinerary is shaped around fit, pace, and priorities.
          </p>
        </Details>
      </div>
    </div>
  </section>
</Layout>

<script>
  import gsap from 'gsap'
  import { SplitText } from 'gsap/SplitText'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { lockScroll, releaseScroll, videoReady, waitFor } from '~/lib/utils'

  gsap.registerPlugin(SplitText, ScrollTrigger)

  lockScroll()

  Promise.race([
    waitFor(6666),
    Promise.all([videoReady(document.getElementById('heroVid')), document.fonts.ready]),
  ]).then(() => {
    let h1 = document.querySelector('#heroText h1')!,
      byline = document.querySelector('#heroText p')!,
      h1Split = SplitText.create(h1, { type: 'lines' })

    gsap
      .timeline({
        onComplete: () => {
          window.dispatchEvent(new CustomEvent('heroRevealed', { detail: {} }))
          h1Split.revert()
          releaseScroll()
        },
      })
      .to('#loading svg', { opacity: 0, duration: 0.5 })
      .fromTo(
        '#loading',
        { clipPath: 'inset(0 0 0% 0)' },
        { clipPath: 'inset(0 0 100% 0)', duration: 1.2, ease: 'expo.inOut' },
        '-=.2',
      )
      .set(h1, { autoAlpha: 1 })
      .from(h1Split.lines, { autoAlpha: 0, y: 40, duration: 0.6, stagger: { each: 0.2 } }, '-=.2')
      .from(byline, { autoAlpha: 0, y: 10, duration: 0.6 }, '-=.2')
  })

  const laurelsSplit = SplitText.create('#laurels p', { type: 'lines' })
  gsap.set('#laurels p', { autoAlpha: 1 })
  gsap
    .timeline({ scrollTrigger: { trigger: '.introInfo', start: 'start bottom', once: true } })
    .from('#laurels img', { autoAlpha: 0, yPercent: 35, stagger: 0.12 })
    .from(
      laurelsSplit.lines,
      {
        autoAlpha: 0,
        yPercent: 35,
        stagger: 0.12,
        onComplete: () => {
          laurelsSplit.revert()
        },
      },
      '-=.24',
    )
    .from('.introInfo', { autoAlpha: 0, yPercent: 35, stagger: 0.12 }, '-=.24')
</script>
