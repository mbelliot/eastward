---
import { sanityClient } from 'sanity:client'
import { defineQuery } from 'groq'
import ItineraryCover, { itineraryCoverFragment } from '@/itineraries/ItineraryCover.astro'
import Layout from '~/layouts/Layout.astro'
import Theme from '@/Theme.astro'

const itinerariesIndexQuery = defineQuery(`{
  "themes": *[_type == 'theme'],
  "itineraries": *[_type == 'itinerary'] ${itineraryCoverFragment}
  } `)
const { themes, itineraries } = (await sanityClient.fetch(itinerariesIndexQuery, {}))!
---

<Layout variant="mono">
  <header class="flex flex-col gap-15 items-center pt-[32dvh] clamp-[pb,50px,150px]">
    <h1 class="text-billboard">Itineraries</h1>
    <div role="toolbar" class="flex gap-x-10 gap-y-6 max-w-300 flex-wrap justify-center">
      {
        themes.map((theme) => (
          <button class="flex gap-2 border rounded-full border-mono-a px-8 py-2 items-center">
            <Theme class="fill-text size-10" theme={theme} />
            <span>{theme.name}</span>
          </button>
        ))
      }
    </div>
  </header>
  {
    itineraries.map((itn, i) => (
      <ItineraryCover itinerary={itn} variant={Boolean(i % 2) ? 'flipped' : 'default'} />
    ))
  }
</Layout>
