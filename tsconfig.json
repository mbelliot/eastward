{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "sanity.types.ts"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/components/*"],
      "$/*": ["./src/assets/*"],
      "~/*": ["./src/*"],
      "sanity.types": ["./sanity.types.ts"]
    },
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ]
  }
}
